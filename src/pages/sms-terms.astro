---
import Base from "../layouts/Base.astro";
// ⚖ ATTORNEY REVIEW BEFORE LAUNCH (plan §12.1). Written to match the actual
// consent flow in src/data/consent.ts / submit-lead.js (version 2026-10-05.1)
// and /text-consent. One program, no marketing (A2P 10DLC registration).
---

<Base
  title="SMS & Communications Terms | Hendrix Ventures Group"
  description="Hendrix Ventures Group LLC's text messaging terms: what you'll receive, message frequency, rates, and how to opt out at any time."
  path="/sms-terms"
>
  <section class="legal">
    <div class="container-narrow">
      <h1>SMS &amp; Communications Terms</h1>
      <p class="legal-effective">Effective October 5, 2026</p>

      <h2>The program</h2>
      <p>
        Hendrix Ventures Group LLC texts homeowners about one thing: the
        property they asked us about. Messages cover replies to your request,
        scheduling a walkthrough, your offer, and updates on the sale if you
        go ahead. We send no marketing or promotional texts, and we never text
        numbers from purchased lists.
      </p>
      <p>
        We text you only after you agree — by checking the optional box on our
        offer form, by saying yes when we ask on a phone call, or by texting us
        first. Agreeing to texts is never required to get an offer. See
        <a href="/text-consent">how you agree to texts</a> for each of these,
        word for word.
      </p>

      <h2>The fine print that matters</h2>
      <ul>
        <li>Message frequency varies. Message and data rates may apply.</li>
        <li>
          Reply <strong>STOP</strong> at any time to stop receiving texts —
          we treat STOP as a full opt-out across our messaging and honor it
          promptly. You may receive one final message confirming the opt-out.
        </li>
        <li>Reply <strong>HELP</strong> for help, or contact us below.</li>
        <li>
          You can also opt out or change preferences any time by emailing
          <a href="mailto:hasani@hendrixventures.com"
            >hasani@hendrixventures.com</a
          >
          or calling <a href="tel:+16787105786">(678) 710-5786</a>.
        </li>
        <li>
          Carriers are not liable for delayed or undelivered messages.
        </li>
        <li>
          No mobile telephone numbers or SMS consent information are shared
          with third parties or affiliates for marketing or promotional
          purposes. See our <a href="/privacy">Privacy Policy</a>.
        </li>
      </ul>

      <h2>Contact</h2>
      <p>
        Hendrix Ventures Group LLC · 1700 Northside Dr NW, Suite A7 #813,
        Atlanta, GA 30318 ·
        <a href="tel:+16787105786">(678) 710-5786</a> ·
        <a href="mailto:hasani@hendrixventures.com"
          >hasani@hendrixventures.com</a
        >
      </p>
    </div>
  </section>
</Base>
