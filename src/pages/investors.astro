---
import Base from "../layouts/Base.astro";
import InvestorInventory from "../islands/InvestorInventory";
import BuyerSignup from "../islands/BuyerSignup";
---

<Base
  title="Investor Deals | Hendrix Ventures Group"
  description="Off-market investment property inventory from Hendrix Ventures Group in metro Atlanta, Georgia — and first look at new deals for serious buyers."
  path="/investors"
  sticky="investor"
>
  <section class="inv-intro">
    <div class="container">
      <div class="inv-header">
        <div class="inv-header-text">
          <h1>Investor inventory</h1>
          <p class="lede">
            Off-market Georgia deals from our acquisitions pipeline.
          </p>
          <p class="inv-contact">
            Questions or offers:
            <a href="mailto:hasani@hendrixventures.com"
              >hasani@hendrixventures.com</a
            >
            <span aria-hidden="true">·</span>
            <a href="tel:+16787105786" class="nowrap">(678) 710-5786</a>
          </p>
        </div>
        <a href="#buyer-list" class="btn btn-primary inv-header-cta"
          >Get first look at new deals</a
        >
      </div>
      <InvestorInventory client:load />
    </div>
  </section>

  <section class="inv-signup" id="buyer-list">
    <div class="container">
      <BuyerSignup client:load />
    </div>
  </section>
</Base>

<style>
  .inv-intro {
    padding-block: var(--space-7) var(--space-8);
  }
  .inv-header-text h1 {
    margin-bottom: var(--space-3);
  }
  .lede {
    font-size: var(--text-lg);
    color: var(--color-ink-soft);
    max-width: 36rem;
    margin-bottom: var(--space-2);
  }
  .inv-contact {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    margin: 0;
  }
  .nowrap {
    white-space: nowrap;
  }
  .inv-signup {
    padding-block: clamp(var(--space-6), 5vw, var(--space-8)) 0;
    border-top: 1px solid var(--color-line);
    /* With the top padding, clears the sticky header (61-68px tall) */
    scroll-margin-top: var(--space-7);
  }
  /* The header's nav wraps here and the header grows to 95-139px */
  @media (min-width: 861px) and (max-width: 1179px) {
    .inv-signup {
      scroll-margin-top: 7.5rem;
    }
  }
</style>
