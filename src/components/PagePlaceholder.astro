---
// Temporary stub used while pages are built out in later phases. Every route
// exists from day one so the preview never dead-ends; each stub still carries
// honest content and the two real actions.
export interface Props {
  heading: string;
  lede: string;
}
const { heading, lede } = Astro.props;
---

<section class="placeholder">
  <div class="container-narrow">
    <h1>{heading}</h1>
    <p class="lede">{lede}</p>
    <slot />
    <div class="placeholder-actions">
      <a href="/get-offer" class="btn btn-primary">Get my cash offer</a>
      <a href="tel:+16787105786" class="btn btn-secondary"
        >Call or text (678) 710-5786</a
      >
    </div>
  </div>
</section>

<style>
  .placeholder {
    padding-block: var(--space-8);
  }
  .lede {
    font-size: var(--text-lg);
    color: var(--color-ink-soft);
    max-width: 60ch;
  }
  .placeholder-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-6);
  }
</style>
