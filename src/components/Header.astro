---
import Logo from "./Logo.astro";

export interface Props {
  cta?: "seller" | "investor";
}
const { cta = "seller" } = Astro.props;
// ⚖ Investor pages are the investor A2P campaign's evidence, so their call to
// action stays on the buyer list instead of sending a reviewer to /get-offer.
const action =
  cta === "investor"
    ? { href: "/investors#buyer-list", label: "Get deals" }
    : { href: "/get-offer", label: "Get my offer" };

// Slim, warm-neutral header (plan §7.1) — not a full-saturation brand bar.
const nav = [
  { href: "/how-it-works", label: "How It Works" },
  { href: "/houses-weve-bought", label: "Houses We've Bought" },
  { href: "/reviews", label: "Reviews" },
  { href: "/about", label: "About" },
  { href: "/faq", label: "FAQ" },
];
// Built pages are served as "/about/"; the hrefs above have no trailing slash.
const current = Astro.url.pathname.replace(/(.)\/$/, "$1");
const ariaCurrent = (href: string) => (current === href ? "page" : undefined);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="wordmark" aria-label="Hendrix Ventures Group — home">
      <Logo size={36} />
      <span class="wordmark-text">Hendrix <span>Ventures Group</span></span>
    </a>
    <nav aria-label="Main" class="site-nav">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={ariaCurrent(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="header-actions">
      <a href="tel:+16787105786" class="header-phone">(678) 710-5786</a>
      <a href={action.href} class="btn btn-primary header-cta">{action.label}</a>
      <!-- The same links for every width they don't fit inline. A native
           disclosure, so it opens with no script; the script below only adds
           the ways people expect to close one. -->
      <details class="site-menu">
        <summary>
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <path class="menu-bars" d="M4 7h16M4 12h16M4 17h16"></path>
            <path class="menu-cross" d="M6 6l12 12M18 6L6 18"></path>
          </svg>
          <span class="menu-label">Menu</span>
        </summary>
        <nav aria-label="Main" class="site-menu-panel">
          <ul role="list">
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={ariaCurrent(item.href)}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-3);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark-text span {
    color: var(--color-brand);
  }

  .site-nav {
    flex: 1;
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .site-nav a {
    color: var(--color-ink-soft);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .site-nav a:hover,
  .site-nav a[aria-current="page"] {
    color: var(--color-ink);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .header-phone {
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .header-cta {
    white-space: nowrap;
    padding: 0.55em 1.1em;
    font-size: var(--text-sm);
  }

  .site-menu {
    display: none;
  }

  .site-menu summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding-inline: var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .site-menu summary::-webkit-details-marker {
    display: none;
  }

  .site-menu[open] summary {
    border-color: var(--color-ink-soft);
  }

  .menu-cross,
  .site-menu[open] .menu-bars {
    display: none;
  }

  .site-menu[open] .menu-cross {
    display: inline;
  }

  /* Phones: a sheet the full width of the header, hanging from its edge. */
  .site-menu-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-surface);
    border-block: 1px solid var(--color-line);
    box-shadow: var(--shadow);
  }

  .site-menu-panel ul {
    list-style: none;
    margin: 0;
    padding: var(--space-2) var(--space-5);
  }

  .site-menu-panel li + li {
    border-top: 1px solid var(--color-line);
  }

  .site-menu-panel a {
    display: block;
    padding-block: var(--space-3);
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
  }

  .site-menu-panel a[aria-current="page"] {
    color: var(--color-brand);
  }

  /* The five links need about 1120px beside the wordmark, phone and button.
     Short of that they used to wrap and the sticky header grew to 95-139px. */
  @media (max-width: 1179px) {
    .site-nav {
      display: none;
    }

    .site-menu {
      display: block;
    }

    .header-inner {
      justify-content: space-between;
    }
  }

  /* The sticky bottom bar carries "Get my offer" from here down. Tighter
     padding keeps the header at 61px now that the 44px menu button sets its
     height. */
  @media (max-width: 860px) {
    .header-cta {
      display: none;
    }

    .header-inner {
      padding-block: var(--space-2);
    }

    /* A phone held sideways is shorter than the open menu, and the bottom
       bar sits over whatever reaches it. Stop above the bar and scroll
       inside instead: 8.5rem is this header plus the bar, and the bar grows
       by the home-indicator inset on notched phones. */
    .site-menu-panel {
      max-height: calc(100vh - 8.5rem - env(safe-area-inset-bottom, 0px));
      max-height: calc(100dvh - 8.5rem - env(safe-area-inset-bottom, 0px));
      overflow-y: auto;
    }
  }

  /* Room to spare: the sheet becomes a card under the button instead. */
  @media (min-width: 640px) {
    .site-menu {
      position: relative;
    }

    .site-menu-panel {
      top: calc(100% + var(--space-2));
      left: auto;
      right: 0;
      width: 17rem;
      border: 1px solid var(--color-line);
      border-radius: var(--radius-lg);
    }
  }

  /* Under 640px the mark carries the identity alone — the full name, the
     phone and the menu button cannot share one row. */
  @media (max-width: 639px) {
    .wordmark-text {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .header-inner,
    .header-actions {
      gap: var(--space-3);
    }

    /* If it ever fails to fit, a second row beats a page that scrolls
       sideways. */
    .header-inner {
      flex-wrap: wrap;
    }

    .header-phone {
      font-size: var(--text-sm);
    }
  }

  /* The narrowest phones: the icon alone, the word kept for screen readers */
  @media (max-width: 349px) {
    .menu-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
</style>

<script>
  const menu = document.querySelector<HTMLDetailsElement>(".site-menu");
  if (menu) {
    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
    // Tabbing past the last link would otherwise leave the menu open over
    // the page behind the reader.
    menu.addEventListener("focusout", (event) => {
      const next = event.relatedTarget as Node | null;
      if (next && !menu.contains(next)) menu.open = false;
    });
    // Coming back with the browser's Back button restores the page as it was
    // left, menu open and all.
    window.addEventListener("pageshow", () => {
      menu.open = false;
    });
  }
</script>
