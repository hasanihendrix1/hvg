---
import Logo from "./Logo.astro";

// Slim, warm-neutral header (plan §7.1) — not a full-saturation brand bar.
const nav = [
  { href: "/how-it-works", label: "How It Works" },
  { href: "/houses-weve-bought", label: "Houses We've Bought" },
  { href: "/reviews", label: "Reviews" },
  { href: "/about", label: "About" },
  { href: "/faq", label: "FAQ" },
];
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="wordmark" aria-label="Hendrix Ventures Group — home">
      <Logo size={36} />
      <span class="wordmark-text">Hendrix <span>Ventures Group</span></span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={current === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="header-actions">
      <a href="tel:+16787105786" class="header-phone">(678) 710-5786</a>
      <a href="/get-offer" class="btn btn-primary header-cta">Get my offer</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-3);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark-text span {
    color: var(--color-brand);
  }

  /* Under ~480px the mark carries the identity alone — the full name plus a
     phone and a CTA cannot share one row without the header wrapping (the
     overflow this header was already fixed for once). */
  @media (max-width: 480px) {
    .wordmark-text {
      display: none;
    }
  }

  nav {
    flex: 1;
  }

  nav ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  nav a {
    color: var(--color-ink-soft);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--color-ink);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .header-phone {
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .header-cta {
    white-space: nowrap;
    padding: 0.55em 1.1em;
    font-size: var(--text-sm);
  }

  /* Mobile: nav collapses; the sticky bottom bar carries the actions */
  @media (max-width: 860px) {
    nav {
      display: none;
    }
    .header-cta {
      display: none;
    }
    .header-inner {
      justify-content: space-between;
    }
  }

  /* Small phones: shrink the two remaining items so nothing overflows */
  @media (max-width: 480px) {
    .header-inner {
      gap: var(--space-3);
      flex-wrap: wrap;
    }
    .wordmark {
      font-size: var(--text-base);
    }
    .header-phone {
      font-size: var(--text-sm);
    }
  }
</style>
