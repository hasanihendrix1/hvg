---
/**
 * The Hendrix Ventures Group mark.
 *
 * Cut directly from the official artwork — the same file that lives in
 * Brand Assets › Logo Assets › HVG Logos (PNG-01, byte-for-byte the
 * `HVentures-Logo2` asset the previous site already shipped). It is the
 * complete mark: arc, birds, shingled roof, banner, and the HVG script on
 * the wall.
 *
 * Deliberately NOT built from that folder's "Vector FIle" SVGs. Two of them
 * are simplified icon exports that silently drop the banner, the roof
 * shingles, and the HVG script — they render as a plainer house that reads
 * as the logo at a glance but is not it. The raster crop is provably the
 * real artwork; the vectors were not worth the fidelity risk.
 *
 * Its ink is #800000 — measured off the artwork, and the same value as
 * --color-brand, which is where the site's palette was taken from.
 *
 * Decorative: the surrounding link carries the accessible name.
 */
import { Image } from "astro:assets";
import mark from "../assets/hvg-mark.png";

interface Props {
  /** Rendered height; the mark keeps its own aspect ratio. */
  size?: string;
  class?: string;
}
const { size = "2rem", class: className } = Astro.props;
---

<span class:list={["hvg-mark", className]} style={`--mark-size:${size}`}>
  <Image src={mark} alt="" aria-hidden="true" densities={[1, 2, 3]} />
</span>

<style>
  .hvg-mark {
    display: inline-flex;
    flex-shrink: 0;
  }

  .hvg-mark :global(img) {
    height: var(--mark-size);
    width: auto;
    display: block;
  }
</style>
